            "example": 320
          },
          "height": {
            "type": "number",
            "nullable": true,
            "example": 240
          },
          "videoCodec": {
            "type": "string",
            "nullable": true,
            "example": "h264"
          },
          "audioCodec": {
            "type": "string",
            "nullable": true,
            "example": "aac"
          },
          "formatName": {
            "type": "string",
            "nullable": true,
            "example": "mov,mp4,m4a,3gp,3g2,mj2"
          },
          "bitRate": {
            "type": "number",
            "nullable": true,
            "example": 118000
          },
          "frameRate": {
            "type": "number",
            "nullable": true,
            "example": 25
          },
          "sizeBytes": {
            "type": "number",
            "nullable": true,
            "example": 30120
          }
