    "/videos/{publicId}/stream": {
      "get": {
        "description": "Redirects to a short-lived presigned URL of the original video; storage answers Range requests with 206 Partial Content.",
        "operationId": "VideosController_stream",
        "parameters": [
          {
            "name": "publicId",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirect (Location header) to a short-lived presigned URL"
          },
          "401": {
            "description": "Missing or invalid access token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
