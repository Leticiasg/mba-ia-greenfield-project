  "info": {
    "title": "StreamTube API",
    "description": "API REST do StreamTube",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "access-token": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "RegisterDto": {
        "type": "object",
        "properties": {}
      },
      "ResendConfirmationDto": {
        "type": "object",
        "properties": {}
      },
      "LoginDto": {
        "type": "object",
        "properties": {}
      },
      "RefreshTokenDto": {
        "type": "object",
        "properties": {}
      },
      "ForgotPasswordDto": {
        "type": "object",
        "properties": {}
      },
      "ResetPasswordDto": {
        "type": "object",
        "properties": {}
      },
      "CreateVideoDto": {
        "type": "object",
        "properties": {}
      },
      "UploadPlanDto": {
        "type": "object",
        "properties": {
          "publicId": {
            "type": "string",
            "example": "a1B2c3D4e5F",
            "description": "11-character unique id; the video URL is /videos/{publicId}"
          },
          "title": {
            "type": "string",
            "example": "My clip"
          },
          "status": {
            "type": "string",
            "example": "draft"
          },
          "partSize": {
            "type": "number",
            "example": 104857600,
            "description": "Bytes per part"
          },
          "partCount": {
            "type": "number",
            "example": 103,
            "description": "Total parts (1-based numbers)"
          }
        },
        "required": [
          "publicId",
          "title",
          "status",
          "partSize",
