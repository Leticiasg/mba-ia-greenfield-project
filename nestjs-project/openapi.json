          "height",
          "videoCodec",
          "audioCodec",
          "formatName",
          "bitRate",
          "frameRate",
          "sizeBytes"
        ]
      },
      "VideoDto": {
        "type": "object",
        "properties": {
          "publicId": {
            "type": "string",
            "example": "a1B2c3D4e5F"
          },
          "title": {
